<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme. Compose drives the UI; this only needs to be a Material3 theme
         with no action bar so the Compose content owns the window.
         DayNight: follows the system light/dark setting like OriginOS 7 Settings; the Compose
         palette (ui/Theme.kt) does the same. -->
    <style name="Theme.OriginIsle" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Matches the Compose background, so launch shows no lighter flash. -->
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
